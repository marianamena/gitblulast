select a.machine,a.module,a.sql_id,b.sql_text ,sum(a.delta_read_io_bytes/1024/1024/1024) from v$active_session_history a
inner join v$sql b
on a.sql_id = b.sql_id
where a.sample_time > TIMESTAMP '2024-04-28 11:00:00.000'
AND a.sample_time < TIMESTAMP '2024-04-29 10:57:00.000'
group by a.machine,a.module,a.sql_id,b.sql_text 
order by sum(a.delta_read_io_bytes/1024/1024/1024) desc ;
