create job with curesor


DECLARE
  CURSOR c IS
    SELECT t.owner, t.table_name
    FROM   dba_tab_statistics t
           JOIN dba_segments s
             ON t.owner = s.owner
            AND t.table_name = s.segment_name
    WHERE ( t.stale_stats = 'YES'  or  t.stale_stats is null) and t.TABLE_NAME NOT LIKE '$%' AND t.OWNER NOT  LIKE '%SYS%' and  t.owner not in
 ('XSTRMADMIN','DBSNMP','DBSFWUSER','GSMADMIN_INTERNAL','XDB','OGG','ORDDATA','SCHEDULER','GG','OGGUSER','CBS_JOB_SERVICE')
     AND    t.partition_name IS NULL 
    AND    s.segment_type = 'TABLE'
    AND    s.bytes < 20 * 1024 * 1024 * 1024; 
BEGIN
  FOR r IN c LOOP
    DBMS_STATS.GATHER_TABLE_STATS(
      ownname          => r.owner,
      tabname          => r.table_name,
      degree           => 10,
      cascade          => TRUE
    );
  END LOOP;
END;
/




