DECLARE
          ts_name varchar (40);
           c_ts_name ts_name%type;
           CURSOR c_tbs_table is
                select TS_NAME
                  from
                              (
                              select TS_NAME, SUM(DF_FREE_SIZE) TS_FREE_SIZE
                              from
                                          (
                                          select df.tablespace_name TS_NAME,
                                                      decode(AUTOEXTENSIBLE,'YES',((block_size * 4 * 1024 * 1024) - (blocks * block_size))/(1024 * 1024 * 1024),0) DF_FREE_SIZE
                                          from dba_data_files df, dba_tablespaces ts
                                          where df.tablespace_name = ts.tablespace_name
                                                      and ts.bigfile = 'NO'
                                                      and df.tablespace_name not in ('SYSTEM','SYSAUX','SSD')
                                                      and substr(df.tablespace_name, 1, 7) <> 'UNDOTBS'
                                          )
                              group by TS_NAME
                  )  where TS_FREE_SIZE < 30;
        BEGIN
           OPEN c_tbs_table;
           LOOP
              FETCH c_tbs_table into c_ts_name;
              EXIT WHEN c_tbs_table%notfound;
           execute immediate 'alter tablespace '||c_ts_name||' add datafile';
           END LOOP;
           CLOSE c_tbs_table;
        END;


