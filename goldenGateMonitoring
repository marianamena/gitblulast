#part 1: check the number of stopped or abended process

num_stopped=`cat /tmp/test.txt|grep STOPPED|grep -v JAGENT|grep -v PMSRVR|wc -l`
num_abended=`cat /tmp/test.txt|grep ABENDED|grep -v JAGENT|grep -v PMSRVR|wc -l`


