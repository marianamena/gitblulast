#check lag at checkpoint for extract process more than 1 min

cat /tmp/test.txt|grep EXTRACT > /tmp/status_extract_lag.txt




input_file="/tmp/status_extract_lag.txt"

awk '{
    # Split the fourth column ($4) by ":"
    split($4, time_parts, ":");

    # time_parts[1] will be the hours part (e.g., "00" from "00:00:00")
    # time_parts[2] will be the minutes part (e.g., "00" from "00:00:00")
    if (time_parts[1] != "00" || time_parts[2] > "01") {
        print # Print the entire line
    }
