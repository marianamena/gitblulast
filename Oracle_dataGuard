primary :proddb(unique_name:proddb)  hostname: prod server
standby :proddb (unique_name:proddb_stb) hostname:dev server


changes on Primary:
1.primary database must be in archive log mode:

shut immediate;
startup mount;
alter database archivelog;
alter database open;
archive log list;

2. enable force logging:

alter database force logging;
select name,force_logging from v$database;


3.standby file managment parameter:

alter system set standby_file_managment='AUTO';

4. first check number of log file in primary and also size,then add number+1 log file for standby.

select group#,member from v$logfile;
alter database add standby logfile group 11('/u01/....../...log') isze 50m;

5.create password file for standby database:( it should be done in primary)
alter system set remote_login_passwordfile=exclusive scope=spfile
restart the db 
orapwd file=$ORACLE_HOME/dbs/orapwdproddb password=sys force=y ( age bashe replace mikone)

6. check db_unique_name in primary
show parameter unique_name;

7.check parameter db_recovery_file_dest_size;
if needed,increase it.
alter system set db_recoery_file_dest_size=400g;

8.check parameter db_recovery_file_dest


