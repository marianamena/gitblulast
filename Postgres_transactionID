3.payesh jadval baraye hadeaksare mojaz:
WITH params AS (
  SELECT
    current_setting('autovacuum_freeze_max_age')::bigint AS freeze_max_age,
    current_setting('autovacuum_multixact_freeze_max_age')::bigint AS mfreeze_max_age
)
SELECT
  n.nspname AS schema,
  c.relname AS table,
  age(c.relfrozenxid) AS xid_age,
  round(100.0 * age(c.relfrozenxid) / p.freeze_max_age, 2) AS xid_pct_of_max,
  age(c.relminmxid) AS mxid_age,
  round(100.0 * age(c.relminmxid) / p.mfreeze_max_age, 2) AS mxid_pct_of_max,
  pg_size_pretty(pg_relation_size(c.oid)) AS table_size,
  last_autovacuum
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
CROSS JOIN params p
LEFT JOIN pg_stat_all_tables s ON s.relid = c.oid
WHERE c.relkind IN ('r','m')
ORDER BY xid_pct_of_max DESC
LIMIT 100;



