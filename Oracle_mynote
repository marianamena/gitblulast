select 'Tablespace_Name:' || df.A || ' ,T=' ||
       df_u.totalspace || 'GB' || ' ,F=' || tf.freespace || 'GB' ||
       ' ,Total=' || df.totalspace || 'GB' || ' ,Used=' ||
       (df_u.totalspace - tf.freespace) || 'GB' || ' ,Free=' ||
       (df.totalspace - (df_u.totalspace - tf.freespace)) || 'GB' ||
       ' ,Used=' || round((100 * (df_u.totalspace - tf.freespace) /
                          decode(df.totalspace, 0, 0.000001, df.totalspace)),
                          1) || '%' || '          ' ||
       decode(round((100 * (df_u.totalspace - tf.freespace) /
                    decode(df.totalspace, 0, 0.000001, df.totalspace)),
                    0) - 90,
              abs(round((100 * (df_u.totalspace - tf.freespace) /
                        decode(df.totalspace, 0, 0.000001, df.totalspace)),
                        0) - 90),
              decode(round((100 * (df_u.totalspace - tf.freespace) /
                           decode(df.totalspace, 0, 0.000001, df.totalspace)),
                           0) - 95,
                     abs(round((100 * (df_u.totalspace - tf.freespace) /
                               decode(df.totalspace,
                                       0,
                                       0.000001,
                                       df.totalspace)),
                               0) - 95),
                     '(Critical)',
                     '(Warning)'),
              '(Normal)') || ' ' as "Noraml Tablespace Status"
  from (select tablespace_name||con_id A,
               round((sum(decode(autoextensible, 'YES', maxbytes, bytes)) /
                     (1024 * 1024 * 1024)),
                     1) TotalSpace
          from cdb_data_files
         group by tablespace_name||con_id) df,
       (select tablespace_name||con_id B,
               round((sum(bytes) / (1024 * 1024 * 1024)), 1) TotalSpace
          from cdb_data_files
         group by tablespace_name||con_id) df_u,
       (select tablespace_name||con_id C,
               round(sum(bytes) / (1024 * 1024 * 1024), 1) freespace
          from cdb_free_space
         group by tablespace_name||con_id) tf
 where df.A = tf.C
   and df.A = df_u.B
 order by (df_u.totalspace - tf.freespace) /
          decode(df.totalspace, 0, 0.000001, df.totalspace) desc;




