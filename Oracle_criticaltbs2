#criticaltbs2.sql
select
     used.tablespace_name,
     round((reserv.maxbytes - used.bytes)/1024/1024/1024) "Max free GB"
     from
    (select tablespace_name, sum(greatest(maxbytes,bytes)) maxbytes, sum(bytes) bytes from dba_data_files group by tablespace_name) reserv,
    (select tablespace_name, sum(bytes) bytes from dba_segments group by tablespace_name) used
where used.tablespace_name = reserv.tablespace_name
order by 2 desc
